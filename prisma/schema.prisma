// CMFAS LMS — Prisma schema
// Designed so new modules (M5, M5A, M9, M9A, HI, PGI, CFP, etc.) are added
// as DATA (rows in Module/Paper), never as new tables or code branches.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum AssignmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

enum PracticeMode {
  FULL
  QUICK
  CHAPTER
  RECOMMENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerOption {
  A
  B
  C
  D
}

// ─────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  firstName     String?
  lastName      String?
  phone         String?
  selfRegistered Boolean @default(false)
  email         String   @unique
  passwordHash  String
  roles         Role[]   @default([STUDENT])
  active        Boolean  @default(true)
  approvedAt    DateTime?
  pdpaConsent   Boolean  @default(false)
  pdpaConsentAt DateTime?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts      Attempt[]
  assignments   Assignment[]
  auditLogs     AuditLog[]
  practiceSessions PracticeSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([active])
}

// ─────────────────────────────────────────────────────────────────
// Module / Paper structure
// ─────────────────────────────────────────────────────────────────

model Module {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  papers      Paper[]
}

model Paper {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id])
  title           String
  durationMinutes Int
  totalQuestions  Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections        PaperSection[]
  questions       Question[]
  attempts        Attempt[]
  assignments     Assignment[]
  practiceSessions PracticeSession[]
}

model PaperSection {
  id                String   @id @default(cuid())
  paperId           String
  paper             Paper    @relation(fields: [paperId], references: [id])
  name              String
  order             Int
  questionCount     Int
  passThresholdPct  Decimal  @db.Decimal(5, 2)

  questions         Question[]
  sectionScores     AttemptSectionScore[]

  @@unique([paperId, order])
}

model Topic {
  id       String  @id @default(cuid())
  moduleId String
  code     Int?
  name     String

  questions Question[]
  practiceSessions PracticeSession[]

  @@unique([moduleId, code])
}

// ─────────────────────────────────────────────────────────────────
// Question bank
// ─────────────────────────────────────────────────────────────────

model Question {
  id            String       @id @default(cuid())
  paperId       String
  paper         Paper        @relation(fields: [paperId], references: [id])
  sectionId     String
  section       PaperSection @relation(fields: [sectionId], references: [id])
  topicId       String?
  topic         Topic?       @relation(fields: [topicId], references: [id])

  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer AnswerOption
  explanation   String
  difficulty    Difficulty   @default(MEDIUM)
  orderInPaper  Int?

  isDuplicateOf String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attemptAnswers AttemptAnswer[]
  practiceAnswers PracticeAnswer[]

  @@index([paperId])
  @@index([sectionId])
  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────────
// Assignments (admin assigns papers to students)
// ─────────────────────────────────────────────────────────────────

model Assignment {
  id           String    @id @default(cuid())
  paperId      String
  paper        Paper     @relation(fields: [paperId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       AssignmentStatus @default(APPROVED)
  assignedDate DateTime  @default(now())
  dueDate      DateTime?

  @@unique([paperId, userId])
  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// Attempts
// ─────────────────────────────────────────────────────────────────

model Attempt {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId         String
  paper           Paper         @relation(fields: [paperId], references: [id])

  status          AttemptStatus @default(IN_PROGRESS)
  startTime       DateTime      @default(now())
  submitTime      DateTime?
  serverDeadline  DateTime

  pausedRemainingSeconds Int?

  questionIds     Json?

  overallScore    Decimal?      @db.Decimal(5, 2)
  passed          Boolean?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  answers         AttemptAnswer[]
  sectionScores   AttemptSectionScore[]

  @@index([userId])
  @@index([paperId])
  @@index([userId, paperId, status])
}

model AttemptSectionScore {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId  String
  section    PaperSection @relation(fields: [sectionId], references: [id])

  correctCount Int
  totalCount   Int
  scorePct     Decimal    @db.Decimal(5, 2)
  passed       Boolean

  @@unique([attemptId, sectionId])
}

model AttemptAnswer {
  id             String        @id @default(cuid())
  attemptId      String
  attempt        Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question      @relation(fields: [questionId], references: [id])

  selectedAnswer AnswerOption?
  correct        Boolean       @default(false)
  flagged        Boolean       @default(false)
  answeredAt     DateTime?     @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ─────────────────────────────────────────────────────────────────
// Audit (admin actions, security-relevant events)
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────────
// Practice – separate from Attempt
// ─────────────────────────────────────────────────────────────────

model PracticeSession {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId     String
  paper       Paper        @relation(fields: [paperId], references: [id])
  mode        PracticeMode
  topicId     String?
  topic       Topic?       @relation(fields: [topicId], references: [id])
  questionIds Json
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  serverDeadline DateTime?

  answers     PracticeAnswer[]

  @@index([userId])
}

model PracticeAnswer {
  id             String          @id @default(cuid())
  sessionId      String
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question        @relation(fields: [questionId], references: [id])
  selectedAnswer AnswerOption?
  correct        Boolean         @default(false)
  answeredAt     DateTime?       @updatedAt

  @@unique([sessionId, questionId])
}

// ─────────────────────────────────────────────────────────────────
// Password reset
// ─────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}
