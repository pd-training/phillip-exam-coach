// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AssignmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerOption {
  A
  B
  C
  D
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  passwordHash         String
  roles                Role[]
  active               Boolean   @default(false)
  approvedAt           DateTime?
  pdpaConsent          Boolean   @default(false)
  pdpaConsentAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  assignments          Assignment[]
  attempts             Attempt[]
  sessions             Session[]
  accounts             Account[]
  passwordResetTokens  PasswordResetToken[]

  @@index([email])
}

model Module {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  papers      Paper[]

  @@index([code])
}

model Topic {
  id        String   @id @default(cuid())
  moduleId  String
  code      Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([moduleId, code])
  @@index([moduleId])
}

model Paper {
  id               String   @id @default(cuid())
  moduleId         String
  title            String
  durationMinutes  Int
  totalQuestions   Int
  passThresholdPct Int      @default(75)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  module           Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sections         PaperSection[]
  questions        Question[]
  assignments      Assignment[]
  attempts         Attempt[]

  @@index([moduleId])
}

model PaperSection {
  id               String   @id @default(cuid())
  paperId          String
  name             String
  order            Int
  questionCount    Int
  passThresholdPct Int      @default(75)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  paper     Paper      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questions Question[]
  scores    AttemptSectionScore[]

  @@index([paperId])
}

model Question {
  id               String   @id @default(cuid())
  paperId          String
  sectionId        String
  topicId          String
  questionText     String
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  correctAnswer    AnswerOption
  explanation      String?
  difficulty       Difficulty @default(MEDIUM)
  orderInPaper     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  paper    Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  section  PaperSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic    Topic          @relation(fields: [topicId], references: [id])
  answers  AttemptAnswer[]

  @@index([paperId])
  @@index([sectionId])
  @@index([topicId])
}

model Assignment {
  id        String            @id @default(cuid())
  paperId   String
  userId    String
  status    AssignmentStatus  @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
  @@index([userId])
}

model Attempt {
  id                    String         @id @default(cuid())
  paperId               String
  userId                String
  status                AttemptStatus  @default(IN_PROGRESS)
  startTime             DateTime       @default(now())
  submittedAt           DateTime?
  overallScore          Float?
  passed                Boolean?
  serverDeadline        DateTime?
  questionIds           String[]
  pausedRemainingSeconds Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  paper              Paper                  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers            AttemptAnswer[]
  sectionScores      AttemptSectionScore[]
  auditLog           AuditLog[]

  @@index([paperId])
  @@index([userId])
  @@index([status])
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  selectedOption AnswerOption?
  isCorrect  Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

model AttemptSectionScore {
  id        String   @id @default(cuid())
  attemptId String
  sectionId String
  score     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section PaperSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([sectionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  attemptId String
  action    String
  details   String?
  createdAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model PracticeSession {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers PracticeAnswer[]

  @@index([userId])
}

model PracticeAnswer {
  id              String   @id @default(cuid())
  sessionId       String
  questionId      String?
  selectedOption  AnswerOption?
  createdAt       DateTime @default(now())

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
