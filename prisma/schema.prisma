// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  role          String    @default("STUDENT") // ADMIN | STUDENT
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  studentPapers  StudentPaper[]
  paperRequests  PaperRequest[]

  @@map("User")
}

// Papers & Questions
model Paper {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String   @db.Text @default("")
  durationMinutes  Int
  totalQuestions   Int      @default(0)
  isAvailable      Boolean  @default(false)
  passingScore     Int      @default(75)
  timeWarning      Int      @default(5)
  showAnswerReview Boolean  @default(true)
  allowRetakes     Boolean  @default(false)
  retakeLimit      Int      @default(0)
  totalTime        Int      @default(120)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions      Question[]
  examParts      ExamPart[]
  chapters       Chapter[]
  attempts       ExamAttempt[]
  studentPapers  StudentPaper[]
  paperRequests  PaperRequest[]

  @@index([isAvailable])
  @@map("Paper")
}

model Chapter {
  id      String @id @default(cuid())
  paperId String @db.Uuid
  number  Int
  title   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, number])
  @@index([paperId])
  @@map("Chapter")
}

model Question {
  id               String   @id @default(uuid()) @db.Uuid
  paperId          String   @db.Uuid
  chapterNumber    Int
  questionText     String   @db.Text
  optionA          String   @db.Text
  optionB          String   @db.Text
  optionC          String   @db.Text
  optionD          String   @db.Text
  correctAnswer    String   @db.VarChar(1) // A, B, C, D
  explanation      String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([chapterNumber])
  @@map("Question")
}

model ExamPart {
  id             String   @id @default(uuid()) @db.Uuid
  paperId        String   @db.Uuid
  partName       String   @db.VarChar(50)
  chapterStart   Int
  chapterEnd     Int
  questionCount  Int
  passingScore   Int
  orderIndex     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([orderIndex])
  @@map("ExamPart")
}

// Exam Attempts
model ExamAttempt {
  id          String   @id @default(cuid())
  paperId     String   @db.Uuid
  userId      String
  startedAt   DateTime
  submittedAt DateTime?
  score       Int?
  passed      Boolean?
  createdAt   DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("examattempt")
}

// Student Paper Access
model StudentPaper {
  id         String   @id @default(cuid())
  userId     String
  paperId    String   @db.Uuid
  status     String   @default("active") // active | requested | rejected
  requestedAt DateTime?
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper  Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId])
  @@index([status])
  @@map("StudentPaper")
}

// Paper Access Requests
model PaperRequest {
  id                String   @id @default(cuid())
  userId            String
  paperId           String   @db.Uuid
  status            String   @default("pending") // pending | approved | rejected
  rejectionReason   String?
  requestedAt       DateTime @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper  Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("PaperRequest")
}

// Legacy models (placeholder)
model QuestionPool {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  @@map("QuestionPool")
}
